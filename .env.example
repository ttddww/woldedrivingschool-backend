PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
DB_PATH=./data/wds.db

# First admin account created by `npm run seed` if the email does not exist
ADMIN_EMAIL=admin@woldedrivingschool.local
ADMIN_PASSWORD=ChangeMeNow!Admin1

# Stripe (server only — never put the secret key in the frontend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (server-side secret; use sandbox for testing, live for production)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# If Stripe/PayPal are unconfigured or a call to them fails, simulate a
# successful payment locally so it still lands in the database. Defaults to
# true outside production. Set to false once real, verified credentials are
# in place in a live deployment, so a real provider outage surfaces as a
# failure instead of a fake success.
PAYMENT_FALLBACK_TEST_MODE=true

# Email: log (default), smtp, or webhook
EMAIL_PROVIDER=log
EMAIL_FROM=Wolde Driving School <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_WEBHOOK_URL=
