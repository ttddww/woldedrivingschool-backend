PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL connection string. Use the connection string from
# Supabase Dashboard -> Connect -> PostgreSQL.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=require
DB_POOL_MAX=10

# First admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Server-side payment credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYMENT_FALLBACK_TEST_MODE=false

# Email: log, smtp, or webhook
EMAIL_PROVIDER=log
EMAIL_FROM=Wolde Driving School <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_WEBHOOK_URL=
